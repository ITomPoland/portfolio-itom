# Hakkilo XR — environment variables (Vite). Copy to `.env` and fill in.
# `.env` is git-ignored; NEVER commit real keys. Only VITE_* vars reach the client bundle.

# --- Contact form (Web3Forms) ---------------------------------------------
# Create a free access key at https://web3forms.com. Without it the contact
# form renders but sends nothing (intentional safe default).
VITE_WEB3FORMS_KEY=

# --- Analytics (PostHog) --------------------------------------------------
# Optional. If VITE_POSTHOG_KEY is empty, analytics is fully disabled and the
# consent banner never appears. Tracking stays OFF until the user consents.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.posthog.com
